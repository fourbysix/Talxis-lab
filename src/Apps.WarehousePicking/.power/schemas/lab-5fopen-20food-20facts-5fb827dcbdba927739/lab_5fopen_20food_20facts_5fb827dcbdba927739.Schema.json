        "title": "Open Food Facts",
        "description": "Look up product data by barcode from the Open Food Facts public database.",
        "version": "1.0"
      },
      "host": "39172f8c354de6549fdadd47ef47c9.1a.environment.api.powerplatform.com",
      "basePath": "/connectors/runtime/invoke/scalegroups/usa002/shards/01/apis/lab-5fopen-20food-20facts-5fb827dcbdba927739/connections/",
      "schemes": [
        "https"
      ],
      "consumes": [],
      "produces": [
        "application/json"
      ],
      "paths": {
        "/{connectionId}/product/{barcode}.json": {
          "get": {
            "operationId": "GetProductByBarcode",
            "summary": "Get product by barcode",
            "parameters": [
              {
                "name": "connectionId",
                "in": "path",
                "required": true,
                "x-ms-visibility": "internal",
                "type": "string"
              },
              {
                "name": "barcode",
                "in": "path",
                "required": true,
                "type": "string"
              }
            ],
            "responses": {
              "200": {
                "description": "Product details",
                "schema": {
                  "$ref": "#/definitions/Product"
                }
              }
            }
          }
        },
        "/{connectionId}/product-image": {
          "get": {
            "operationId": "GetProductImage",
            "summary": "Get product image",
            "produces": [
              "image/jpeg",
              "image/png"
            ],
            "parameters": [
              {
                "name": "connectionId",
                "in": "path",
                "required": true,
                "x-ms-visibility": "internal",
                "type": "string"
              },
              {
                "name": "imageUrl",
                "in": "query",
                "required": true,
                "type": "string"
              }
            ],
            "responses": {
              "200": {
                "description": "Product image bytes",
                "schema": {
                  "type": "file",
                  "x-ms-media-kind": "image"
                }
              }
            }
          }
        }
      },
      "definitions": {
        "Product": {
          "type": "object",
          "properties": {
            "ean": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
